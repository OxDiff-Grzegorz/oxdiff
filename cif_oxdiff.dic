    _definition.id               '_oxdiff.cell_length_a'
    _definition.scope            Item
    _definition.class            Datum
    _definition.update           2026-11-10
    _description.text            'Length of the a axis of the raw unit cell used by the CrysAlisPro processing software before applying symmetry constraints.'
