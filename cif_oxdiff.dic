    _name.category_id            OXDIFF
    _name.object_id              cell_length_a
    _type.purpose                Measurand
    _type.source                 Derived
    _type.container              Single
    _type.contents               Real
    _enumeration.range           0.:
    _units.code                  angstroms
    _description_example.case    5.96265(13)
